ntributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":20,"line":45,"offset":1939},"start":{"column":16,"line":45,"offset":1935}},"value":1000}}],"sourceMap":{"end":{"column":6,"line":46,"offset":1946},"start":{"column":23,"line":44,"offset":1917}}},"compiled":false,"id":"fd64fc17-c3fe-4de2-b4ac-612b053680ec","isOverride":false,"metadata":[],"name":"pesoTara","parameters":[],"problems":[],"scope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":6,"line":46,"offset":1946},"start":{"column":5,"line":44,"offset":1899}}}],"metadata":[{"args":{"position":"start","text":"/* # Camión de transporte\r\n\r\nUna empresa de transporte quiere administrar mejor las cargas que lleva un camión.\r\n\r\nPara eso requiere un sistema que le permita planificar qué cosas debe llevar el camión sin sobrepasar su capacidad. Por otro lado, las cosas que transporta tienen un nivel de peligrosidad. Este nivel es usado para impedir que cosas que superen cierto nivel de peligrosidad circulen en determinadas rutas.\r\n\r\n## El camión\r\nSe pide que el camión entienda los siguientes mensajes:\r\n\r\n* `cargar(cosa)`: para agregar una cosa en el camión, validando que no supere el peso máximo de 2.5 toneladas;\r\n* `descargar(cosa)`: para eliminar una cosa del camión, validando que no se intente descargar algo que no estaba cargado;\r\n* `pesoTotal()`: es la suma del peso del camión vacío (tara) y su carga. La tara del camión es de 1 tonelada (1000 kilogramos);\r\n* `excedidoDePeso()`: indica si el peso total es superior al peso máximo;\r\n* `objetosPeligrosos(nivel)`: todos los objetos cargados que superan el nivel de peligrosidad indicados por el valor del parámetro;\r\n* `objetosMasPeligrososQue(cosa)`: todos los objetos cargados que son más peligrosos que la cosa;\r\n* `puedeCircularEnRuta(nivelMaximoPeligrosidad)` Puede circular si ninguna cosa que transporta supera el `nivelMaximoPeligrosidad`.\r\n\r\nIncluir como mínimo los siguientes tests:\r\n* Para `cargar` y `descargar`, dos tests de cada uno (un caso exitoso y otro inválido).\r\n* Para los demás métodos, al menos un test de cada uno.\r\n*/"},"name":"comment"}],"name":"camion","problems":[{"code":"malformedMember","sourceMap":{"end":{"column":22,"line":24,"offset":1535},"start":{"column":5,"line":24,"offset":1518}}}],"scope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"sourceMap":{"end":{"column":2,"line":47,"offset":1949},"start":{"column":1,"line":23,"offset":1497}},"supertypes":[]},"stack":"Error: Failed to print, found malformed node\n    at c:\\Users\\facu_\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:68:3585\n    at Ybn (c:\\Users\\facu_\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:68:3396)\n    at c:\\Users\\facu_\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:2430:847\n    at c:\\Users\\facu_\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\\src\\server.js:2430:8440\n    at c:\\Users\\facu_\\.vscode\\extensions\\uqbar.wollok-lsp-ide-0.5.5\\out\\server\